# ─── Juice Studio — Environment Variables ─────────────────────
# Copy this file to .env and fill in your API keys.
# The app works fully without any keys (falls back to local mode).

# ── AI Chat Providers ─────────────────────────────────────
# OpenAI (GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=sk-...
# Optional: override model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Optional: override API base URL for proxies/gateways
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude Sonnet / Haiku)
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override model (default: claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Optional: override API base URL
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ── Music Generation Providers ─────────────────────────────
# Suno AI — beat generation
SUNO_API_KEY=...
# Optional: override API base URL
# SUNO_BASE_URL=https://api.suno.ai/v1

# Udio — beat generation
UDIO_API_KEY=...
# Optional: override API base URL
# UDIO_BASE_URL=https://api.udio.com/v1

# ── Social Publishing ───────────────────────────────────────
# SoundCloud App credentials (https://soundcloud.com/you/apps)
SOUNDCLOUD_CLIENT_ID=...
SOUNDCLOUD_CLIENT_SECRET=...

# YouTube / Google Cloud OAuth credentials
# (https://console.cloud.google.com/apis/credentials)
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...

# OAuth Redirect URI (used by SoundCloud/YouTube)
# This should match the redirect URI configured in your app's OAuth settings.
# Default (local dev): http://localhost:3000/auth/callback
# Production: https://d0389dfcbcab4f049ee5fc4293a9e185.ctonew.app/auth/callback
OAUTH_REDIRECT_URI=
